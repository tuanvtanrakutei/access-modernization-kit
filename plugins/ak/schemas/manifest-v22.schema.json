{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sms.local/schemas/manifest-v22.schema.json",
  "title": "Access Modernization App Manifest V2.2",
  "type": "object",
  "required": ["version", "app"],
  "properties": {
    "version": {"enum": ["2.1", "2.2"]},
    "app": {
      "type": "object", "required": ["id", "name_en"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,15}$"},
        "name_en": {"type": "string", "minLength": 1},
        "name_ja": {"type": "string"}, "name_vi": {"type": "string"}
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "profile": {"type": "string"}, "profile_version": {"type": "string"},
        "classification": {
          "type": "object",
          "required": ["topology", "frontend_format", "source_availability", "backend_kinds"],
          "additionalProperties": false,
          "properties": {
            "topology": {"enum": ["monolith", "split_file", "client_server", "hybrid"]},
            "frontend_format": {"enum": ["mdb", "accdb", "adp", "mde", "accde", "exported"]},
            "source_availability": {"enum": ["full", "compiled_only", "exported_only", "mixed"]},
            "backend_kinds": {"type": "array", "minItems": 1, "items": {"enum": ["embedded_access", "access_file", "sql_server", "odbc_database", "text_or_csv", "spreadsheet", "external_application", "unknown_boundary"]}}
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "role", "acquisition", "required", "source_ref"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
          "role": {"enum": ["frontend", "backend", "interface", "documentation", "unknown"]},
          "format": {"type": "string"}, "backend_kind": {"type": "string"},
          "acquisition": {"enum": ["managed", "imported", "mixed"]}, "required": {"type": "boolean"},
          "source_ref": {
            "type": "object", "required": ["type", "value"], "additionalProperties": false,
            "properties": {
              "type": {"enum": ["local_path", "workspace_path", "external_path", "secret_ref", "bundle_ref", "generated_ref"]},
              "value": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "if": {"properties": {"version": {"const": "2.2"}}},
  "then": {"required": ["version", "app", "project"], "properties": {"project": {"required": ["classification"]}}}
}
