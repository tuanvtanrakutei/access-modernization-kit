{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sms.local/schemas/evidence.schema.json",
  "title": "Access Modernization Evidence Register",
  "type": "object",
  "required": [
    "app_id",
    "generated_at",
    "items"
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": [
        "id",
        "run_id",
        "app_id",
        "phase",
        "role",
        "task_id",
        "statement",
        "status",
        "source_type",
        "source_path",
        "confidence",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,15}-P[1-6]-[A-Z0-9_]+-[0-9]{3,}$"
        },
        "run_id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "role": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "EXTRACTED",
            "INFERRED",
            "AMBIGUOUS"
          ]
        },
        "source_type": {
          "enum": [
            "VBA",
            "SQL",
            "SCREENSHOT",
            "REPORT",
            "XLSX",
            "PDF",
            "CSV",
            "TXT",
            "RUNTIME",
            "INTERVIEW",
            "STAKEHOLDER_DECISION",
            "OTHER"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "source_location": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_language": {
          "enum": [
            "EN",
            "JA",
            "VI",
            "OTHER"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agent_runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_class": {
          "enum": [
            "SCHEMA",
            "CODE",
            "ENVIRONMENT",
            "UI_DEFINITION",
            "SCREENSHOT",
            "SAMPLE_DATA",
            "OUTPUT_SAMPLE",
            "DOCUMENT",
            "INTERVIEW",
            "OPERATOR_DECLARATION",
            "TARGET_INTENT"
          ],
          "description": "What kind of support this item gives, per specifications/evidence-classes.yaml. Distinct from source_type, which is the medium: a CSV may be SAMPLE_DATA or OUTPUT_SAMPLE."
        },
        "claim_kind": {
          "enum": [
            "STRUCTURE",
            "BEHAVIOUR",
            "FORMAT",
            "MEANING",
            "USAGE",
            "INTENT",
            "SCOPE"
          ],
          "description": "What the statement asserts. Checked against the class: a MEANING claim on a SCHEMA item is rule EC-01."
        },
        "attribution": {
          "type": "object",
          "description": "Who said it and when. Required for INTERVIEW, so a later contradiction can be taken back to them.",
          "required": [
            "person",
            "recorded_on"
          ],
          "properties": {
            "person": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string"
            },
            "recorded_on": {
              "type": "string",
              "format": "date"
            },
            "question_id": {
              "type": "string",
              "description": "The Q- identifier this answers, if it closes one."
            }
          },
          "additionalProperties": false
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "description": "An E- errata identifier, when this item replaces a claim that was wrong. The superseded item keeps its own id and gains a note."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXTRACTED"
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "const": 1.0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "INTERVIEW"
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "required": [
              "attribution"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
