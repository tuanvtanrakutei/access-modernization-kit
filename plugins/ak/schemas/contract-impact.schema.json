{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sms.local/schemas/contract-impact.schema.json",
  "title": "Collaboration Contract Impact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "impact_id", "work_package_id", "work_package_digest",
    "changed_paths", "affected_contracts", "compatibility",
    "migration_behavior", "synthetic_fixtures", "compatibility_tests",
    "documentation_updates", "validation_evidence", "untested_runtime_paths",
    "untested_runtime_reason", "security_and_data_handling_impact",
    "release_target", "reviewer"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "impact_id": {"type": "string", "pattern": "^CI-[A-Z0-9_-]+$"},
    "work_package_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "work_package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "changed_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "affected_contracts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "compatibility": {
      "enum": ["compatible", "migration_required", "breaking"]
    },
    "migration_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "summary"],
      "properties": {
        "required": {"type": "boolean"},
        "summary": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
      }
    },
    "synthetic_fixtures": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "compatibility_tests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "documentation_updates": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "validation_evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"}
    },
    "untested_runtime_paths": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "untested_runtime_reason": {
      "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "security_and_data_handling_impact": {
      "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "release_target": {"const": "2.7.2"},
    "reviewer": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
  }
}
