* text=auto
*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.xls binary
*.mdb binary
*.accdb binary
*.adp binary

# VBA modules are CRLF by convention, and the VBE importer can baulk at a
# lone LF. Stored LF in the repository, checked out CRLF in the working tree,
# so `git diff` stays clean and the file an operator imports into Access is
# the shape Access expects.
*.bas text eol=crlf
